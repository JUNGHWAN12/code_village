[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/board.gd" id="2_board"]
[ext_resource type="Script" path="res://scripts/robot.gd" id="3_robot"]
[ext_resource type="Script" path="res://scripts/camera_rig.gd" id="4_cam"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat"]
sky_top_color = Color(0.32, 0.52, 0.8, 1)
sky_horizon_color = Color(0.85, 0.8, 0.7, 1)
ground_bottom_color = Color(0.22, 0.26, 0.16, 1)
ground_horizon_color = Color(0.85, 0.8, 0.7, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
ambient_light_energy = 1.0
tonemap_mode = 2
tonemap_exposure = 1.1
tonemap_white = 4.0
ssao_enabled = true
ssao_radius = 1.5
ssao_intensity = 1.6
glow_enabled = true
glow_intensity = 0.6
glow_bloom = 0.05
fog_enabled = true
fog_light_color = Color(0.8, 0.82, 0.84, 1)
fog_density = 0.0022
fog_sky_affect = 0.3

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="LeftPanel" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_type_variation = &"SidePanel"

[node name="Margin" type="MarginContainer" parent="Layout/LeftPanel"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Layout/LeftPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="AppTitle" type="Label" parent="Layout/LeftPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.6, 0.45, 1)
theme_override_font_sizes/font_size = 14
text = "CODE VILLAGE · 코드로 움직이는 마을 로봇"

[node name="LevelRow" type="HBoxContainer" parent="Layout/LeftPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PrevButton" type="Button" parent="Layout/LeftPanel/Margin/VBox/LevelRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "이전 레벨"
text = "◀"

[node name="LevelTitle" type="Label" parent="Layout/LeftPanel/Margin/VBox/LevelRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
text = "1. 첫 걸음"
clip_text = true

[node name="NextButton" type="Button" parent="Layout/LeftPanel/Margin/VBox/LevelRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "다음 레벨"
text = "▶"

[node name="LevelSelect" type="OptionButton" parent="Layout/LeftPanel/Margin/VBox/LevelRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
tooltip_text = "레벨 고르기"

[node name="GoalCard" type="PanelContainer" parent="Layout/LeftPanel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="GoalText" type="RichTextLabel" parent="Layout/LeftPanel/Margin/VBox/GoalCard"]
unique_name_in_owner = true
layout_mode = 2

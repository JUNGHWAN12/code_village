text = "목표"
fit_content = true

[node name="PaletteLabel" type="Label" parent="Layout/LeftPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.6, 0.45, 1)
theme_override_font_sizes/font_size = 14
text = "명령 블록 — 누르면 커서 위치에 들어가요"

[node name="Palette" type="HFlowContainer" parent="Layout/LeftPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="CodeEdit" type="CodeEdit" parent="Layout/LeftPanel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
size_flags_vertical = 3
placeholder_text = "여기에 코드를 적어요. 예: move()"
caret_blink = true
highlight_current_line = true
draw_tabs = true
gutters_draw_line_numbers = true
indent_use_spaces = true
indent_automatic = true
auto_brace_completion_enabled = true
auto_brace_completion_highlight_matching = true

[node name="Controls" type="HBoxContainer" parent="Layout/LeftPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RunButton" type="Button" parent="Layout/LeftPanel/Margin/VBox/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 44)
layout_mode = 2
tooltip_text = "코드 실행 (F5 / Ctrl+Enter)"
theme_override_colors/font_color = Color(0.75, 1, 0.7, 1)
theme_override_font_sizes/font_size = 19
text = "▶ 실행"

[node name="StepButton" type="Button" parent="Layout/LeftPanel/Margin/VBox/Controls"]
unique_name_in_owner = true

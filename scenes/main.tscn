render_target_update_mode = 4

[node name="WorldEnvironment" type="WorldEnvironment" parent="Layout/ViewContainer/SubViewport"]
environment = SubResource("Env")

[node name="Sun" type="DirectionalLight3D" parent="Layout/ViewContainer/SubViewport"]
transform = Transform3D(0.788011, 0, 0.615661, 0.484809, 0.615661, -0.620526, -0.379039, 0.788011, 0.485148, 0, 12, 0)
light_color = Color(1, 0.95, 0.85, 1)
light_energy = 1.9
shadow_enabled = true
directional_shadow_max_distance = 80.0

[node name="CameraRig" type="Node3D" parent="Layout/ViewContainer/SubViewport"]
unique_name_in_owner = true

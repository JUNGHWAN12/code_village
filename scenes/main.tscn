[node name="Camera3D" type="Camera3D" parent="Layout/ViewContainer/SubViewport/CameraRig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 20)
current = true
fov = 45.0
far = 300.0

[node name="Board" type="Node3D" parent="Layout/ViewContainer/SubViewport"]
